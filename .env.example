# AdvoCal – Environment Variables
# Copy this file to .env and fill in the real values.
# All EXPO_PUBLIC_* variables are safe to include in the app bundle (client-side).

# ── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL  (Settings → API → Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase anonymous/public key  (Settings → API → anon public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Edge Functions base URL  (usually same as SUPABASE_URL)
EXPO_PUBLIC_FUNCTIONS_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon key used when calling Edge Functions (same key as above)
EXPO_PUBLIC_FUNCTIONS_ANON_KEY=eyJ...

# ── App identity ─────────────────────────────────────────────────────────────
# Internal app-id (used for analytics / diagnostics only)
EXPO_PUBLIC_APP_ID=app-c90by552ew3l
